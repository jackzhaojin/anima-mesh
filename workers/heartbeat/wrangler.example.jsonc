// TEMPLATE ONLY — the real deploy config lives in the INSTANCE repo's
// cloud/ workspace (D12: the engine is generic; deploying is an instance
// act). Copy, fill account_id and vars, deploy from there.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "animamesh-heartbeat",
  "main": "src/index.ts", // instance configs point at the engine checkout instead
  "account_id": "<CLOUDFLARE ACCOUNT ID>",
  "compatibility_date": "2026-07-01",
  // Protect pending DO calls, timers and waitUntil work without a client.
  "compatibility_flags": ["durable_object_io_tasks_prevent_eviction"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "HEARTBEAT_DO", "class_name": "HeartbeatDO" },
      { "name": "DIRECTION_DO", "class_name": "DirectionDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HeartbeatDO"] },
    { "tag": "v2", "new_sqlite_classes": ["DirectionDO"] }
  ],
  "vars": {
    "BRAIN_REPO": "<owner/name>",
    "BRAIN_REF": "main",
    "BEAT_TIMEZONE": "America/New_York",
    "BEAT_HOUR": "8"
    // "MOONSHOT_BASE_URL": "https://api.kimi.com/coding/v1", // when the key is endpoint-scoped
    // "DISCORD_PUBLIC_KEY": "<discord app verify key>",      // enables POST /interactions (inbound direction)
    // "SLACK_CHANNEL_ID": "<C... channel id>",                // Slack brief channel (bot mode; invite the app first)
    // "SLACK_ALLOWED_USER_IDS": "<U...,U...>",                // who may direct by @-mention; absent = nobody
    // "SLACK_ALLOWED_CHANNEL_IDS": "<C...>",                  // channels where mentions are answered; absent = any the app is in
    // "DIRECTION_DAILY_CAP": "20",                           // direction budget (decision Q4)
    // "DIRECTION_GMAIL_POLL_MINUTES": "20",                  // Gmail poll cadence; 0/absent = inbound email off
    // "DIRECTION_GMAIL_ALLOWED_FROM": "<principal email>"    // only this sender's mail becomes directions
    // "MSGRAPH_TENANT": "<entra tenant id or domain>",        // 'onedrive' source; default "common"
    // "MSGRAPH_DRIVE_ID": "<drive id>",                       // a specific drive; default the consenting user's OneDrive
    // "MSGRAPH_CABINET_PATH": "<folder under the drive root>" // default the drive root
    // "GITHUB_DOCS_REPO": "<owner/docs-repo>",                // 'github-docs' source; absent = unconfigured
    // "GITHUB_DOCS_REF": "main",                              // default HEAD (the repo's default branch)
    // "GITHUB_DOCS_PATH": "<subpath>"                         // only list paths under this subpath
    // "GMAIL_READ_QUERY": "in:inbox newer_than:2d",           // 'gmail' source (the PRINCIPAL's account); default shown in docs
    // "GMAIL_READ_MAX": "20",                                 // messages per run, cap 50
    // "GCAL_READ_CALENDARS": "primary",                       // 'google-calendar' source; comma-separated ids
    // "GCAL_READ_DAYS_AHEAD": "14",                           // window ahead; GCAL_READ_DAYS_BACK default 1
    // "GDRIVE_READ_DAYS": "14",                               // 'google-drive' source; files modified in the last N days
    // "GDRIVE_READ_MAX": "25"                                 // files listed per run, cap 100; GDRIVE_READ_QUERY narrows
  }
  // Secrets (wrangler secret put): brain-repo auth is the GitHub App trio
  // GITHUB_APP_ID, GITHUB_APP_INSTALLATION_ID, GITHUB_APP_PRIVATE_KEY
  // (PKCS#8 PEM — convert GitHub's PKCS#1 download with
  // `openssl pkcs8 -topk8 -nocrypt`, and PIPE the file in:
  // `wrangler secret put GITHUB_APP_PRIVATE_KEY < app.pem`) — or a
  // standing PAT in GITHUB_TOKEN, used when no App var is set (a
  // long-lived PAT is a first-class setup, v0.11.2); plus
  // BEAT_TRIGGER_TOKEN;
  // cognition uses MOONSHOT_API_KEY, CLAUDE_CODE_OAUTH_TOKEN, and/or
  // ANTHROPIC_API_KEY (anthropic-api-key: metered credits). No Codex
  // secret: chatgpt.com blocks Workers egress, so Codex is laptop-tier
  // (docs/learnings/2026-10-11-chatgpt-codex-blocks-workers.md);
  // Discord surfaces use DISCORD_BOT_TOKEN and DISCORD_DM_USER_ID;
  // Slack (v2.3, docs/slack.md) uses SLACK_BOT_TOKEN and
  // SLACK_SIGNING_SECRET (the latter enables POST /slack/events), or a
  // delivery-only SLACK_WEBHOOK_URL;
  // for inbound email also GMAIL_CLIENT_ID, GMAIL_CLIENT_SECRET,
  // GMAIL_REFRESH_TOKEN (needs gmail.modify scope), AGENT_EMAIL;
  // for the 'onedrive' read source MSGRAPH_CLIENT_ID, MSGRAPH_REFRESH_TOKEN
  // (+ MSGRAPH_CLIENT_SECRET only for confidential clients) — delegated
  // Files.Read.All consent, read-only; validate with GET /graph/check;
  // for the 'github-docs' read source GITHUB_DOCS_TOKEN (fine-grained PAT,
  // Contents READ-ONLY on the docs repo; falls back to GITHUB_TOKEN; public
  // repos need none) — validate with GET /docs/check.
  // `defect-report`: THE STANDARD POSTURE (v0.11.2, issue-first v0.11.4)
  // is GITHUB_DEFECTS_TOKEN (a standing PAT, Issues R/W on the ENGINE
  // repo — a year-long expiry is the intended shape; renew on a calendar):
  // leak-clean reports file directly as public issues in-run, no draft
  // kept, and every instance carrying the token can open issues. Without
  // it (or on a leak/API failure) reports land as drafts in the instance
  // repo via the store write — no secret needed — and accumulate for
  // `anima-mesh defect file`.
  // anthropic-api uses subscription OAuth over plain fetch;
  // ANTHROPIC_API_KEY is not used by this adapter.
  // v2.0 (docs/layered-brains.md): the principal's own Google account for
  // the 'gmail' / 'google-calendar' / 'google-drive' read sources - GOOGLE_READ_CLIENT_ID,
  // GOOGLE_READ_CLIENT_SECRET, GOOGLE_READ_REFRESH_TOKEN (read-only scopes,
  // minted on the laptop by `anima-mesh connect google`); and one
  // BRAIN_LINK_<ID>_TOKEN per linked brain read over GitHub (a fine-grained
  // token, Contents READ-ONLY on exactly that repo; never GITHUB_TOKEN).
}
